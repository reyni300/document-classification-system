# ============================================
# PYTHON
# ============================================

# Кеш Python (ЭТО САМОЕ ВАЖНОЕ!)
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# Виртуальное окружение
venv/
env/
.venv/
ENV/

# ============================================
# БАЗЫ ДАННЫХ (ОЧЕНЬ ВАЖНО!)
# ============================================

# Ваша база данных — НЕЛЬЗЯ ПУШИТЬ! 430 МБ — это слишком много для GitHub
*.db
*.sqlite
*.sqlite3
documents.db

# ============================================
# ФАЙЛЫ ПРОЕКТА (не должны быть в гите)
# ============================================

# Сгенерированный файл с кодом (не нужен в репозитории)
project_code.txt

# Логи
*.log
*.pid

# ============================================
# КОНФИГИ С СЕКРЕТАМИ
# ============================================

# Ваш конфиг может содержать пароли/ключи
config.yaml
*.key
*.pem
*.crt

# Переменные окружения
.env
.env.*
!.env.example

# ============================================
# DOCKER
# ============================================

# Docker временные файлы
docker-compose.override.yml
.dockerignore

# ============================================
# СИСТЕМНЫЕ ФАЙЛЫ (Linux)
# ============================================

# Файлы подкачки редакторов
*.swp
*.swo
*~
.*.swp

# Файлы ядра Linux
core
core.*

# ============================================
# IDE
# ============================================

.vscode/
.idea/
*.iml

# ============================================
# ВРЕМЕННЫЕ ФАЙЛЫ
# ============================================

tmp/
temp/
*.tmp
*.orig
*.rej
# ============================================
# ДАННЫЕ И ТЕСТОВЫЕ ФАЙЛЫ (НЕ ПУШИТЬ!)
# ============================================

data/
photo/
test_files/
*.pdf
*.jpg
*.jpeg
*.png
*.tiff
*.tif
*.bmp
